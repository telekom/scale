{
  "name": "@telekom/scale-visual-tests",
  "private": true,
  "version": "3.0.0-beta.162",
  "main": "index.js",
  "license": "MPL-2.0",
  "scripts": {
    "test:prepare": "node scripts/prepare.js",
    "copy": "node scripts/prepare.js --copy",
    "test": "node scripts/run-container.js",
    "test:ci": "node \"$PLAYWRIGHT_CLI\" test --grep-invert @interaction --update-snapshots=none --workers=1",
    "test:update": "node scripts/run-container.js --update-snapshots=all",
    "test:interaction": "node scripts/run-container.js --config=playwright.interaction.config.js --update-snapshots=none",
    "test:interaction:native": "playwright test --config=playwright.interaction.config.js --update-snapshots=none",
    "test:interaction:ci": "node \"$PLAYWRIGHT_CLI\" test --config=playwright.interaction.config.js --update-snapshots=none --workers=1",
    "test:interaction:policy": "node scripts/check-interaction-policy.js",
    "test:policy": "node scripts/run-container.js --verify-policy",
    "format": "prettier --write \"package.json\" \"src/**/*.js\" \"scripts/*.js\" \"./*.js\""
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1"
  }
}
